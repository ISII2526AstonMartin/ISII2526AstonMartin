@page "/SeleccionarBonosParaComprar/CompraBonoDetails"
@using AppForSEII2526.Web.API
@*@using Microsoft.AspNetCore.Authorization*@
@inject AppForSEII2526APIClient apiclient
@inject CompraBonosStateContainer cbsc 

<h3>Compra Bono Details</h3>

@if (CompraBonoDTO == null)
{
    <p>@error</p>
}
else
{
    <table class="table table-borderless table-sm">
        <tr>
            <th>Nombre y apellidos</th>
            <td id="NameSurname">@CompraBonoDTO.NombreCliente @CompraBonoDTO.Apellido1 @(CompraBonoDTO.Apellido2 ?? "")</td>
        </tr>
        <tr>
            <th>Método de pago</th>
            <td id="PaymentMethod">@CompraBonoDTO.MetodoPago</td>
        </tr>
        <tr>
            <th>Fecha de compra</th>
            <td id="RentalDate">@CompraBonoDTO.FechaCompra.ToString("dd/MM/yyyy hh:mm:ss")</td>
        </tr>
    </table>

    <h4>Bonos Comprados</h4>
    <table class="table" id="BonosCompradosTable">
        <thead>
            <tr>
                <th scope="col">Nombre</th>
                <th scope="col">Tipo</th>
                <th scope="col">Precio</th>
                <th scope="col">Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (CompraBonoItemDTO item in CompraBonoDTO.CompraItems)
            {
                <tr id="CompraBonoItem_@item.NombreBono">
                    <td>@item.NombreBono</td>
                    <td>@item.TipoBocadillo</td>
                    <td>@item.Pvp €</td>
                    <td>@item.Cantidad</td>
                </tr>
            }
        </tbody>
        <tfoot>
        <th scope="row" colspan="2" class="text-end">Precio Total</th>
        <td id="TotalPrice">@TotalPriceThis €</td>
        </tfoot>
    </table>
}

@code {
    public float preciofinal = 0;
    [Parameter]
    [SupplyParameterFromQuery]
    public int Id { get; set; }
    private CompraBonoDetailsDTO CompraBonoDTO;
    private string error = "";
    public decimal TotalPriceThis
    {
        get
        {
            return Convert.ToDecimal(CompraBonoDTO.CompraItems.Sum(ci => ci.Pvp * ci.Cantidad));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            CompraBonoDTO = await apiclient.GetCompraAsync(Id);
            cbsc.CompraProcessed();
        }
        catch (ApiException exception)
        {
            CompraBonoDTO = null;
            //error = exception.ToString();
        }
        if (CompraBonoDTO == null)
        {
            error = $"Error! You are not authorized to see this rental or there is not a rental with id={Id}";
        }
    }
}

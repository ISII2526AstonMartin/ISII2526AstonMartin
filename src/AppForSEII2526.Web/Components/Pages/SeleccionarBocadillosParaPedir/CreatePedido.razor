@page "/SeleccionarBocadillosParaPedir/CreatePedido"

@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<AppForSEII2526APIClient> logger
@inject CompraBocadilloStateContainercs compraState
<h3>Create Pedido</h3>




<EditForm Model="compra" OnValidSubmit="OpenDialog">
    <div class="row">

        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>


    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compra.Nombre" class="form-control" id="Nombre" />
                <label for="Nombre">Nombre </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compra.Apellido1" class="form-control" id="Apellido1" />
                <label for="PrimerApellido">Primer Apellido </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="compra.Apellido2" class="form-control" id="Apellido2" /> 
                <label for="SegundoApellido">Segundo Apellido</label>
            </div>
        </div>
    </div>



    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @*a dropdown for selecting the payment method*@
                <InputSelect class="form-select" @bind-Value="@compra.MetodoPago" id="MetodoPago">
                    <option value="@MetodoPago.Tarjeta" default> Tarjeta</option>
                    <option value="@MetodoPago.Paypal"> PayPal</option>
                    <option value="@MetodoPago.Gpay"> Gpay</option>
                </InputSelect>
                <label for="MetodoPago">Metodo de Pago</label>
            </div>
        </div>

        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to rent the movies*@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Compra tu Bocadillo
                </button>
            </div>
        </div>

    </div>

    <h4>Detalle de Compra</h4>

      <p>
        <b id ="precioTotal">Precio Total:</b> @PrecioTotal €
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyCompra" id="ModifyCompra">
            Modifica Bocadillo
        </button>
    </p>



    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfRentalItems">
            <thead>
                <tr>
                    <th>Nombre Bocadillo</th>
                    <th>Tipo Pan</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in compra.ItemPedido)
                {
                    <tr id="Data_@item.NombreBocadillo">
                        <td>@item.NombreBocadillo</td>
                        <td>@item.TipoPan</td>
                        <td>@item.Pvp</td>
                        <td><InputNumber @bind-Value="item.Cantidad" class="form-control" id="@($"Cantidad:{item.Id}")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>



@if (DialogIsOpen)
{
    <Dialog Caption="Compra Bocadillo"
    Message="Quieres proceder a selecionar un bocadillo?"
    OnClose="@OnDialogClose"
    Type=Dialog.Category.SaveNot>
    </Dialog>
}


@code {

    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    
    private bool DialogIsOpen;

    private decimal PrecioTotal
    {
        get
        {
            
            double precio = compra.ItemPedido.Sum(ri => ri.Pvp * ri.Cantidad);
            return Convert.ToDecimal(precio);
        }
    }
    
    private void ModifyCompra()
    {
        navigation.NavigateTo("/SeleccionarBocadillosParaPedir/SelectBocadillos");
    }
    
    private CreatePedidoDTO compra => compraState.Compra;
    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid

            

            if (compra.ItemPedido.Count > 0)
            {
                try
                {
                    var comprado = await apiclient.CreatePedidoAsync(compra);
                    compraState.CompraProcessed();
                    navigation.NavigateTo($"/SeleccionarBocadillosParaPedir/DetailPedido/?CompraID={comprado.Id}"); //Navegacion del Details
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";

                }





            }

        }
    }


    protected override async Task OnInitializedAsync()
    {
        compra.Nombre = compra.Nombre == null ? "" : compra.Nombre;
        compra.Apellido1 = compra.Apellido1 == null ? "" : compra.Apellido1;
        compra.Apellido2 = compra.Apellido2 == null ? "" : compra.Apellido2;
        
    }


}


@page "/Resenyas/SelectBocadilloForResenya"

@using AppForSEII2526.Web
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectBocadilloForResenya> logger
@inject ResenyaStateContainer resenyaState
@inject NavigationManager navigation

<h3>Select Bocadillo For Resenya</h3>

<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Nombre</span>
                        <input type="text" id="inputNombre" @bind=bocadilloNombre class="form-control" placeholder="Nombre" aria-label="Nombre" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon2">Precio Máximo</span>
                        <input type="number" step="0.01" id="inputPrecio" @bind=precioMaximo class="form-control" placeholder="Precio Máximo" aria-label="Precio Máximo" aria-describedby="basic-addon2">
                    </div>
                </div>

                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@SearchBocadillos id="searchBocadillos">Search bocadillos</button>
                </div>
            </div>
            <div class="row">
                @if (bocadillos == null)
                {
                    <p>Cargando bocadillos....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfBocadillos">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Tamaño</th>
                                    <th>Tipo Pan</th>
                                    <th>PVP</th>
                                    <th>Agregar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bocadillo in bocadillos)
                                {
                                    <tr id="BocadilloData_@bocadillo.Nombre">
                                        <td>@bocadillo.Nombre</td>
                                        <td>@bocadillo.Tamanyo</td>
                                        <td>@bocadillo.TipoPan</td>
                                        <td>@bocadillo.Pvp</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="bocadilloToAdd_@bocadillo.Nombre" @onclick="@(() => AddBocadillo(bocadillo))">Add</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                }
            </div>
        </div>
        <div class="col-4" hidden="@hideResenyaCart">
            <div class="row">
                <h3>Resenya Cart</h3>
            </div>
            @foreach (ItemResenyaDTO item in resenya.Items)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="removeBocadillo_@item.BocadilloNombre" @onclick="@(() => RemoveResenyaItem(item))">x @item.BocadilloNombre - @item.Pvp€</button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="createResenyaButton" @onclick=@CreateResenya>Create Resenya</button>
            </div>
        </div>
        
    </div>

</div>

@code {
    private ICollection<BocadillosDTO> bocadillos;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string bocadilloNombre { get; set; }
    private float? precioMaximo { get; set; }

    private CreateResenyaDTO resenya => resenyaState.Resenya;

    private bool hideResenyaCart = true;

    private void AddBocadillo(BocadillosDTO bocadillo)
    {
        resenyaState.AddBocadilloToResenya(new ItemResenyaDTO()
        {
            BocadilloId = bocadillo.Id,
            BocadilloNombre = bocadillo.Nombre,
            Tamanyo = bocadillo.Tamanyo,
            Pvp = bocadillo.Pvp
        });
        hideResenyaCart = false;
    }

    private void RemoveResenyaItem(ItemResenyaDTO item)
    {
        resenyaState.RemoveResenyaItemToAdd(item);
        if (resenya.Items.Count == 0) hideResenyaCart = true;
    }

    public async void SearchBocadillos()
    {
        try
        {
            bocadillos = await apiclient.GetBocadillosResenyaAsync(bocadilloNombre, precioMaximo);
            errors = "";
        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
        StateHasChanged();
    }


    protected override async Task OnInitializedAsync()
    {
        SearchBocadillos();

       
        if (resenya.Items.Count > 0)
        {
            hideResenyaCart = false;
        }
        else
        {
            hideResenyaCart = true;
        }

        base.OnInitializedAsync();
    }



    private void CreateResenya()
    {
        navigation.NavigateTo("/Resenyas/createresenya");
    }
}

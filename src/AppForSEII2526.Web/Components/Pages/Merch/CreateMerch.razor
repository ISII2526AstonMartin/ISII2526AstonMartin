@page "/Merch/CreateMerch"

@using AppForSEII2526.Web
@using AppForSEII2526.Web.API
@inject NavigationManager navigation
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreateMerch> logger
@inject MerchStateContainer merchState

<h3>Comprar Merchandising - Introducir Datos</h3>

@* Usamos 'merch' que es la propiedad enlazada al StateContainer *@
<EditForm Model="merch" OnValidSubmit="ProcessPurchase" OnInvalidSubmit="HandleInvalidSubmit">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>

    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>

    @if (!merchState.HasItems())
    {
        <div class="alert alert-info">
            <p>El carrito está vacío. Necesitas añadir productos para continuar.</p>
            <button class="btn btn-secondary" type="button" @onclick="GoToMerchSelection">Volver a la selección</button>
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-md-4">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="merch.NombreUsuario" class="form-control" id="NombreUsuario" />
                    <label for="NombreUsuario">Nombre de Usuario *</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="merch.Apellido1" class="form-control" id="Apellido1" />
                    <label for="Apellido1">Primer Apellido *</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="merch.Apellido2" class="form-control" id="Apellido2" />
                    <label for="Apellido2">Segundo Apellido (Opcional)</label>
                </div>
            </div>

            <div class="col-md-8">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="merch.DireccionEnvio" class="form-control" id="DireccionEnvio" />
                    <label for="DireccionEnvio">Dirección de Envío (Debe contener "Calle") *</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-floating">
                    <InputSelect class="form-select" @bind-Value="@merch.MetodoPago" id="MetodoPago">
                        @foreach (MetodoPago metodo in Enum.GetValues(typeof(MetodoPago)))
                        {
                            <option value="@metodo">@metodo.ToString()</option>
                        }
                    </InputSelect>
                    <label for="MetodoPago">Método de Pago *</label>
                </div>
            </div>

            <div class="col-md-12">
                <div class="d-grid gap-2">
                    <button class="btn btn-primary btn-lg" type="submit" id="Submit">
                        Pagar y Comprar (@merchState.TotalPrice.ToString("0.00")€)
                    </button>
                </div>
            </div>
        </div>

        <p class="mt-3">
            <button class="btn btn-outline-primary" type="button" @onclick="GoToMerchSelection" id="ModificarMerch">
                Modificar Productos
            </button>
        </p>

        <div class="mh-100 table-responsive">
            <table class="table table-condensed table-hover" id="TableOfMerchItems">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Precio Unitario</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in merch.Items)
                    {
                        <tr id="MerchItem_@item.Nombre">
                            <td>@item.Nombre</td>
                            <td>@item.Pvp.ToString("0.00") €</td>
                            <td style="width: 120px;">
                                <InputNumber @bind-Value="item.Cantidad" @onchange="@(e => UpdateQuantity(item, e.Value))"
                                             class="form-control" min="1" />
                            </td>
                            <td>@((item.Pvp * item.Cantidad).ToString("0.00")) €</td>
                            <td>
                                <button class="btn btn-danger btn-sm" type="button" @onclick="() => RemoveMerchItem(item)">
                                    <span class="oi oi-trash" aria-hidden="true">Eliminar</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</EditForm>

@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }

    // Accesor directo al DTO del estado, igual que en el ejemplo de referencia
    private CreateMerchDTO merch => merchState.CreateDTO;

    // Renombrar la clase local para evitar conflicto con el nombre del componente
    private class CreateMerchLogger { }

    protected override void OnInitialized()
    {
        // Inicialización de cadenas para evitar nulos en el EditForm (Crucial del ejemplo de referencia)
        merch.NombreUsuario = merch.NombreUsuario ?? "";
        merch.Apellido1 = merch.Apellido1 ?? "";
        merch.Apellido2 = merch.Apellido2 ?? "";
        merch.DireccionEnvio = merch.DireccionEnvio ?? "";

        merchState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        merchState.OnChange -= StateHasChanged;
    }

    private void HandleInvalidSubmit()
    {
        messageError = "El formulario no es válido. Revisa los campos obligatorios.";
    }

    private void GoToMerchSelection()
    {
        navigation.NavigateTo("/Merch/SelectMerchParaComprar");
    }

    private void UpdateQuantity(ItemMerchDTO item, object? value)
    {
        if (value is string stringValue && int.TryParse(stringValue, out int newQuantity))
        {
            merchState.UpdateItemQuantity(item, newQuantity);
        }
        StateHasChanged();
    }

    private void RemoveMerchItem(ItemMerchDTO item)
    {
        merchState.RemoveMerchItemFromCart(item);
    }

    private async void ProcessPurchase()
    {
        messageError = string.Empty;

        if (!merchState.HasItems())
        {
            messageError = "El carrito está vacío.";
            return;
        }

        try
        {
            // Intentamos la llamada. Si el cliente estuviera bien, esto pasaría.
            // Si el cliente está mal, esto lanzará una excepción 201.
            await apiclient.CreateMerchAsync(merchState.CreateDTO);

            // Si llegamos aquí, es un milagro (o el cliente es void y devolvió 200/204).
            // Pero como no tenemos ID, no podemos ir al ticket específico.
            merchState.MerchProcessed();
            messageError = "¡Compra realizada con éxito! (ID desconocido)";
            // navigation.NavigateTo("/Merch/DetailMerch?compraId=???"); // No podemos ir sin ID

            // Volvemos a la tienda tras un éxito "ciego"
            navigation.NavigateTo("/Merch/SelectMerchParaComprar");
        }
        catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
        {
            // ... (Manejo de validación igual que antes) ...
            if (apiexceptionvalidation.Result?.Errors?.Values != null)
            {
                messageError = "Error de validación: ";
                foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                    messageError += string.Join(", ", errors) + ". ";
            }
            else
            {
                messageError = "Revise los datos del formulario.";
            }
        }
        catch (ApiException apiexception)
        {
            // 🛑 AQUÍ ESTÁ LA CLAVE 🛑
            if (apiexception.StatusCode == 201)
            {
                // El servidor dijo "Created" (201). ¡ÉXITO!
                // Pero el cliente C# explotó porque no esperaba datos.

                // INTENTO DE EXTRACTOR DE ID "A LA FUERZA":
                // La respuesta del servidor (el JSON del DTO) está en apiexception.Response
                // Es algo como: {"nombreUsuario":"...","compraID":15,"...}

                try
                {
                    // Buscamos "compraID":NUMERO usando manipulación de strings simple
                    // para no depender de librerías JSON si no las tienes.
                    string json = apiexception.Response;
                    string searchKey = "\"compraID\":";
                    int index = json.IndexOf(searchKey, StringComparison.OrdinalIgnoreCase);
                    if (index != -1)
                    {
                        int start = index + searchKey.Length;
                        int end = json.IndexOf(",", start);
                        if (end == -1) end = json.IndexOf("}", start);

                        string idString = json.Substring(start, end - start).Trim();
                        if (int.TryParse(idString, out int newId))
                        {
                            // ¡LO TENEMOS!
                            merchState.MerchProcessed();
                            navigation.NavigateTo($"/Merch/DetailMerch?compraId={newId}");
                            return;
                        }
                    }
                }
                catch
                {
                    // Si falla el parseo manual, no pasa nada, seguimos abajo.
                }

                // Si no pudimos sacar el ID, al menos confirmamos éxito y volvemos.
                merchState.MerchProcessed();
                navigation.NavigateTo("/Merch/SelectMerchParaComprar");
                return;
            }

            // ... (Resto de errores igual) ...
            if (apiexception.Response != null && (apiexception.Response.Contains("Error") || apiexception.Response.Contains("Conflict")))
            {
                messageError = apiexception.Response.Replace("\"", "").Trim();
            }
            else
            {
                messageError = $"Error del servidor ({apiexception.StatusCode}). Inténtelo de nuevo.";
            }
        }
        catch (Exception ex)
        {
            messageError = "Ocurrió un error inesperado.";
            Console.WriteLine(ex.ToString());
        }
        StateHasChanged();
    }
    }